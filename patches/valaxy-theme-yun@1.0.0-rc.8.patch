+    mask-image: radial-gradient(
+      circle var(--yun-grid-highlight-radius) at var(--yun-grid-pointer-x, 50%) var(--yun-grid-pointer-y, 50%),
+      black, transparent
+    );
+    transition: opacity 250ms ease;
