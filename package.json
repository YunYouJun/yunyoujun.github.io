{
  "name": "yunyoujun.github.io",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "description": "YunYouJun Blog",
  "author": {
    "email": "me@yunyoujun.cn",
    "name": "YunYouJun",
    "url": "https://www.yunyoujun.cn"
  },
  "license": "CC-BY-NC-SA-4.0",
  "homepage": "https://yunyoujun.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YunYouJun/yunyoujun.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/YunYouJun/yunyoujun.github.io/issues"
  },
  "keywords": [
    "yunyoujun.cn",
    "YunYouJun",
    "云游君",
    "Blog",
    "博客",
    "云游君的小站",
    "www.yunyoujun.cn"
  ],
  "scripts": {
    "algolia": "echo todo",
    "backup": "sh bash/backup.sh",
    "build": "npm run sync:friends && npm run fuse && npm run build:ssg",
    "build:spa": "valaxy build",
    "build:ssg": "valaxy build --ssg --log=info",
    "clean": "rm -rf dist",
    "dev": "valaxy",
    "fuse": "valaxy fuse",
    "rss": "valaxy rss",
    "serve": "vite preview",
    "sync:friends": "tsx scripts/sync-friends.ts",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint .",
    "new": "valaxy new",
    "typecheck": "vue-tsc --noEmit",
    "postinstall": "npx simple-git-hooks"
  },
  "dependencies": {
    "@vueuse/sound": "^2.1.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.7.3",
    "@types/md5": "^2.3.6",
    "@yunyoujun/sponsors": "^0.0.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.1.0",
    "lint-staged": "^16.4.0",
    "md5": "^2.3.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "valaxy": "^0.28.4",
    "valaxy-addon-algolia": "^0.2.1",
    "valaxy-addon-components": "^0.1.0",
    "valaxy-addon-waline": "^0.2.1",
    "valaxy-theme-yun": "^0.28.4",
    "vite-plugin-remote-assets": "^2.1.0",
    "vue-gtag-next": "^1.14.0",
    "vue-tsc": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "simple-git-hooks",
      "vue-demi"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
